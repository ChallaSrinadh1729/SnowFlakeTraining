-- Q3

SELECT
    CUSTOMER_ID,
    CONCAT(FIRST_NAME, ' ', LAST_NAME) AS FULL_NAME,
    CITY,
    STATE,
    CUSTOMER_TIER,
    ANNUAL_REVENUE,

    (SELECT AVG(ANNUAL_REVENUE)
     FROM TRAINING_DB.SALES_SCHEMA.CUSTOMERS) AS OVERALL_AVG_REVENUE

FROM TRAINING_DB.SALES_SCHEMA.CUSTOMERS

WHERE ANNUAL_REVENUE > (
    SELECT AVG(ANNUAL_REVENUE)
    FROM TRAINING_DB.SALES_SCHEMA.CUSTOMERS
)

ORDER BY ANNUAL_REVENUE DESC;

-- Q4

WITH RankedProducts AS (
    SELECT
        PRODUCT_NAME,
        CATEGORY,
        UNIT_PRICE,
        ROW_NUMBER() OVER (
            PARTITION BY CATEGORY
            ORDER BY UNIT_PRICE DESC
        ) AS PRICE_RANK
    FROM TRAINING_DB.SALES_SCHEMA.PRODUCTS
)

SELECT
    PRODUCT_NAME,
    CATEGORY,
    UNIT_PRICE,
    PRICE_RANK
FROM RankedProducts
WHERE PRICE_RANK <= 3
ORDER BY CATEGORY, PRICE_RANK;

-- Q5

WITH DEPT_SUMMARY AS (
    SELECT
        DEPARTMENT,
        COUNT(*) AS EMP_COUNT,
        ROUND(AVG(SALARY), 2) AS AVG_SALARY,
        MAX(SALARY) AS MAX_SALARY,
        MIN(SALARY) AS MIN_SALARY
    FROM TRAINING_DB.SALES_SCHEMA.EMPLOYEES
    GROUP BY DEPARTMENT
    HAVING COUNT(*) > 3
)
SELECT
    DEPARTMENT,
    EMP_COUNT,
    AVG_SALARY,
    MAX_SALARY,
    MIN_SALARY
FROM DEPT_SUMMARY
ORDER BY AVG_SALARY DESC;



