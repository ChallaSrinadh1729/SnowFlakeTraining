--Q10

WITH ORDER_GAPS AS (
    SELECT
        CUSTOMER_ID,
        ORDER_ID,
        ORDER_DATE,

        LEAD(ORDER_DATE) OVER (
            PARTITION BY CUSTOMER_ID
            ORDER BY ORDER_DATE
        ) AS NEXT_ORDER_DATE

    FROM ORDERS
),

CUSTOMER_GAPS AS (
    SELECT
        CUSTOMER_ID,
        DATEDIFF(
            'day',
            ORDER_DATE,
            NEXT_ORDER_DATE
        ) AS GAP_DAYS
    FROM ORDER_GAPS
    WHERE NEXT_ORDER_DATE IS NOT NULL
),

CUSTOMER_AVG_GAP AS (
    SELECT
        CUSTOMER_ID,
        AVG(GAP_DAYS) AS AVG_GAP_DAYS,
        COUNT(*) + 1 AS TOTAL_ORDERS
    FROM CUSTOMER_GAPS
    GROUP BY CUSTOMER_ID
)

SELECT
    CUSTOMER_ID,
    ROUND(AVG_GAP_DAYS, 2) AS AVG_GAP_DAYS,
    TOTAL_ORDERS
FROM CUSTOMER_AVG_GAP
ORDER BY AVG_GAP_DAYS ASC;

-- Q11
WITH CUSTOMER_METRICS AS (
    SELECT
        c.CUSTOMER_ID,
        COUNT(o.ORDER_ID) AS TOTAL_ORDERS,
        SUM(o.TOTAL_AMOUNT) AS TOTAL_SPENT,
        MIN(o.ORDER_DATE) AS FIRST_ORDER_DATE,
        MAX(o.ORDER_DATE) AS LAST_ORDER_DATE,

        DATEDIFF(
            'day',
            MIN(o.ORDER_DATE),
            MAX(o.ORDER_DATE)
        ) AS TENURE_DAYS

    FROM CUSTOMERS c
    JOIN ORDERS o
        ON c.CUSTOMER_ID = o.CUSTOMER_ID

    WHERE o.STATUS <> 'CANCELLED'

    GROUP BY c.CUSTOMER_ID
),

LTV_SCORES AS (
    SELECT
        CUSTOMER_ID,
        TOTAL_ORDERS,
        TOTAL_SPENT,
        FIRST_ORDER_DATE,
        LAST_ORDER_DATE,
        TENURE_DAYS,

        NTILE(5) OVER (
            ORDER BY TOTAL_SPENT
        ) AS M_SCORE,

        NTILE(5) OVER (
            ORDER BY TOTAL_ORDERS
        ) AS F_SCORE,

        NTILE(5) OVER (
            ORDER BY
                DATEDIFF(
                    'day',
                    LAST_ORDER_DATE,
                    CURRENT_DATE()
                ) DESC
        ) AS R_SCORE

    FROM CUSTOMER_METRICS
),

SEGMENTS AS (
    SELECT
        CUSTOMER_ID,
        TOTAL_SPENT,

        CASE
            WHEN R_SCORE >= 4 AND F_SCORE >= 4
                THEN 'Champion'

            WHEN R_SCORE >= 3 AND F_SCORE >= 3
                THEN 'Loyal'

            WHEN R_SCORE >= 4 AND F_SCORE <= 2
                THEN 'New Customer'

            WHEN R_SCORE <= 2 AND F_SCORE >= 3
                THEN 'At Risk'

            ELSE 'Needs Attention'
        END AS SEGMENT

    FROM LTV_SCORES
)

SELECT
    SEGMENT,
    COUNT(*) AS CUSTOMER_COUNT,
    ROUND(AVG(TOTAL_SPENT), 2) AS AVG_LIFETIME_SPEND
FROM SEGMENTS
GROUP BY SEGMENT
ORDER BY AVG_LIFETIME_SPEND DESC;

-- Q12
WITH MONTHLY_REV AS (
    SELECT
        DATE_TRUNC('month', ORDER_DATE) AS SALES_MONTH,
        SUM(TOTAL_AMOUNT) AS MONTHLY_REVENUE

    FROM ORDERS

    WHERE STATUS <> 'CANCELLED'

    GROUP BY DATE_TRUNC('month', ORDER_DATE)
)

SELECT
    SALES_MONTH,
    MONTHLY_REVENUE,

    SUM(MONTHLY_REVENUE) OVER (
        ORDER BY SALES_MONTH
        ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW
    ) AS CUMULATIVE_REVENUE,

    ROUND(
        AVG(MONTHLY_REVENUE) OVER (
            ORDER BY SALES_MONTH
            ROWS BETWEEN 2 PRECEDING AND CURRENT ROW
        ),
        2
    ) AS MOVING_AVG_3M,

    ROUND(
        MONTHLY_REVENUE /
        SUM(MONTHLY_REVENUE) OVER (
            ORDER BY SALES_MONTH
            ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW
        ) * 100,
        2
    ) AS PCT_OF_CUMULATIVE

FROM MONTHLY_REV

ORDER BY SALES_MONTH ASC;

-- Q13
SELECT
    p.CATEGORY,
    p.PRODUCT_NAME,

    SUM(oi.LINE_TOTAL) AS TOTAL_REVENUE,

    SUM(oi.QUANTITY) AS TOTAL_UNITS,

    SUM(SUM(oi.LINE_TOTAL)) OVER (
        PARTITION BY p.CATEGORY
    ) AS CATEGORY_REVENUE,

    ROUND(
        SUM(oi.LINE_TOTAL)
        /
        SUM(SUM(oi.LINE_TOTAL)) OVER (
            PARTITION BY p.CATEGORY
        )
        * 100,
        2
    ) AS MARKET_SHARE_PCT,

    ROW_NUMBER() OVER (
        PARTITION BY p.CATEGORY
        ORDER BY SUM(oi.LINE_TOTAL) DESC
    ) AS RANK_IN_CATEGORY

FROM PRODUCTS p

JOIN ORDER_ITEMS oi
    ON p.PRODUCT_ID = oi.PRODUCT_ID

GROUP BY
    p.CATEGORY,
    p.PRODUCT_ID,
    p.PRODUCT_NAME

QUALIFY RANK_IN_CATEGORY <= 5

ORDER BY
    p.CATEGORY,
    TOTAL_REVENUE DESC;

-- Q14

SELECT
    E.EMPLOYEE_NAME,
    E.DEPARTMENT,
    E.JOB_TITLE,
    E.SALARY,

    COALESCE(M.EMPLOYEE_NAME, 'No Manager') AS MANAGER_NAME,

    M.SALARY AS MANAGER_SALARY,

    CASE
        WHEN M.SALARY IS NULL THEN NULL
        ELSE E.SALARY - M.SALARY
    END AS SALARY_DIFF,

    PERCENT_RANK() OVER (
        PARTITION BY E.DEPARTMENT
        ORDER BY E.SALARY
    ) AS DEPT_PERCENT_RANK,

    CASE
        WHEN PERCENT_RANK() OVER (
            PARTITION BY E.DEPARTMENT
            ORDER BY E.SALARY
        ) >= 0.8
            THEN 'Top 20%'

        WHEN PERCENT_RANK() OVER (
            PARTITION BY E.DEPARTMENT
            ORDER BY E.SALARY
        ) >= 0.2
            THEN 'Mid 60%'

        ELSE 'Bottom 20%'
    END AS SALARY_BAND

FROM EMPLOYEES E

LEFT JOIN EMPLOYEES M
    ON E.MANAGER_ID = M.EMP_ID

ORDER BY
    E.DEPARTMENT,
    E.SALARY DESC;

-- Q15
WITH FIRST_PURCHASE AS (
    SELECT
        CUSTOMER_ID,
        DATE_TRUNC(
            'month',
            MIN(ORDER_DATE)
        ) AS COHORT_MONTH

    FROM ORDERS

    WHERE STATUS <> 'CANCELLED'

    GROUP BY CUSTOMER_ID
),

ACTIVITY AS (
    SELECT DISTINCT
        o.CUSTOMER_ID,
        fp.COHORT_MONTH,
        DATE_TRUNC(
            'month',
            o.ORDER_DATE
        ) AS ORDER_MONTH,

        DATEDIFF(
            'month',
            fp.COHORT_MONTH,
            DATE_TRUNC('month', o.ORDER_DATE)
        ) AS MONTHS_SINCE_FIRST

    FROM ORDERS o

    JOIN FIRST_PURCHASE fp
        ON o.CUSTOMER_ID = fp.CUSTOMER_ID

    WHERE o.STATUS <> 'CANCELLED'
),

COHORT_SIZE AS (
    SELECT
        COHORT_MONTH,
        COUNT(DISTINCT CUSTOMER_ID) AS COHORT_SIZE

    FROM FIRST_PURCHASE

    GROUP BY COHORT_MONTH
),

RETENTION AS (
    SELECT
        COHORT_MONTH,
        MONTHS_SINCE_FIRST,
        COUNT(DISTINCT CUSTOMER_ID) AS ACTIVE_CUSTOMERS

    FROM ACTIVITY

    GROUP BY
        COHORT_MONTH,
        MONTHS_SINCE_FIRST
)

SELECT
    r.COHORT_MONTH,
    r.MONTHS_SINCE_FIRST,
    r.ACTIVE_CUSTOMERS,
    c.COHORT_SIZE,

    ROUND(
        r.ACTIVE_CUSTOMERS
        / c.COHORT_SIZE * 100,
        2
    ) AS RETENTION_RATE_PCT

FROM RETENTION r

JOIN COHORT_SIZE c
    ON r.COHORT_MONTH = c.COHORT_MONTH

ORDER BY
    r.COHORT_MONTH,
    r.MONTHS_SINCE_FIRST;
